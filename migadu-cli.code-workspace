{
  "folders": [{ "path": "." }],
  "settings": {
    "files.exclude": { "**/.git": true, "**/.DS_Store": true },
    "search.exclude": { "**/target": true },
    "files.watcherExclude": { "**/target/**": true },
    "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer", "editor.formatOnSave": true },
    "rust-analyzer.check.command": "clippy",
  },
  "extensions": { "recommendations": ["rust-lang.rust-analyzer"] },
  "tasks": {
    "version": "2.0.0",
    "tasks": [{ "label": "verify", "type": "shell", "command": "bash scripts/verify", "group": "test" }],
  },
}
