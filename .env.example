# Copy to .env (git-ignored). Names and safe placeholders only: never real credentials,
# tokens or production endpoints.
MIGADU_EMAIL=admin@example.org
# Either the key itself (not recommended) ...
MIGADU_API_KEY=changeme
# ... or a password-manager reference, e.g. op://Vault/Migadu/credential, bw:migadu, pass:mail/migadu,
# keepassxc:/path/vault.kdbx#Migadu, keychain:migadu
MIGADU_API_KEY_REF=
MIGADU_DOMAIN=example.org
# Only for tier, catchall, spam and bcc (admin panel): the Cookie header of a signed-in
# admin.migadu.com session, or a password-manager reference to it.
MIGADU_WEB_COOKIE=
MIGADU_WEB_COOKIE_REF=
